# ─── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-use-32-char-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=fraudstream
POSTGRES_PASSWORD=fraudstream_dev
POSTGRES_DB=fraudstream
DATABASE_URL=postgresql://fraudstream:fraudstream_dev@localhost:5432/fraudstream

# ─── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Celery ─────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Model ──────────────────────────────────────────────────────────────────────
MODEL_PATH=./models/xgboost_fraud_v1.pkl
MODEL_METADATA_PATH=./models/model_metadata.json
FRAUD_THRESHOLD=0.5
HIGH_RISK_THRESHOLD=0.75

# ─── CORS ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=1000

# ─── Monitoring ─────────────────────────────────────────────────────────────────
ENABLE_METRICS=true
METRICS_PORT=9090
